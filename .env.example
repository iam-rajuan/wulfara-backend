NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/wulfara
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=30d

